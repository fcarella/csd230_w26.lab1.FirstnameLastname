classDiagram
    Product <|-- Ticket
    Product <|-- Publication
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag

%% --- NEW NICHE: Electronics ---
    Product <|-- Electronics
    Electronics <|-- Phone
    Electronics <|-- Laptop

    SaleableItem <|.. Product
    Serializable <|.. Product
    Product <-- CashTill

    Cart "1" --> "0..*" Product
    CashTill ..> Cart
    CashTill ..> SaleableItem

    class Product{
        -String productId
    }

    class Serializable{
        <<interface>>
    }

    class Ticket{
        +description
        +price
        +sellItem()
    }

    class Publication{
        <<Abstract>>
        -String title
        -double price
        -int copies
        +getPrice()

        +Publication()
        +Publication(String title, double price, int copies)
        +toString()
        +equals()
        +hashCode()
    }

    class Book{
        -String author
        +edit()
        +initialize()
        +sellItem()

        +Book()
        +Book(String author)
        +Book(String author, String title, double price, int copies)
        +toString()
        +equals()
        +hashCode()
    }

    class Magazine{
        -int orderQty
        -java.util.Date currentIssue

        +Magazine()
        +Magazine(int orderQty, Date currentIssue, String title, double price, int copies)

        +edit()
        +initialize()
        +sellItem()
    }

    class DiscMag{
        -boolean hasDisc
        +edit()
        +initialize()
        +sellItem()

        +DiscMag()
        +DiscMag(boolean hasDisc, int orderQty, Date currentIssue, String title, double price, int copies)
    }

%% --- NEW NICHE CLASSES ---
    class Electronics{
        <<Abstract>>
        -int warrantyMonths
        +Electronics()
        +Electronics(String title, double price, int warrantyMonths)
    }

    class Phone{
        -boolean has5g
        +Phone()
        +Phone(String title, double price, int warrantyMonths, boolean has5g)
        +edit()
        +initialize()
        +sellItem()
    }

    class Laptop{
        -int ramGB
        -int storageGB
        +Laptop()
        +Laptop(String title, double price, int warrantyMonths, int ramGB, int storageGB)
        +edit()
        +initialize()
        +sellItem()
    }

    class Cart{
        -List~Product~ items
        +addItem(Product)
        +removeItem(Product)
        +getItems() List~Product~
        +getTotal() double
        +clear()
    }

    class CashTill{
        -double runningTotal
        +CashTill()
        +showTotal()
        +sellItem(SaleableItem item)
    }

    class SaleableItem {
        <<interface>>
        +sellItem()
        +getPrice()
    }
