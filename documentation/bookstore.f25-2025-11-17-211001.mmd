classDiagram
    Editable <|-- Product
    Product <|-- Ticket
    Product <|-- Publication
    Product <|-- AbstractCosmetics
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag
    AbstractCosmetics <|-- Foundation
    AbstractCosmetics <|-- Lipstick
    SaleableItem <|.. Product
    Serializable <|.. Product
    Product <-- CashTill
    Product <-- CartEntity
    Product <-- OrderEntity
    CartEntity --> Product
    OrderEntity --> Product

    class Product {
        <<abstract>>
        -Long id
        -Set~CartEntity~ carts
        -Set~OrderEntity~ orders
        +Long getId()
        +void setId(Long id)
        +Set~CartEntity~ getCarts()
        +void setCarts(Set~CartEntity~ carts)
        +Set~OrderEntity~ getOrders()
        +void setOrders(Set~OrderEntity~ orders)
        +String getProductType()
        +double getPrice()
        +void sellItem()
    }

    class CartEntity {
        -Long id
        -Set~ProductEntity~ products
        +Long getId()
        +void setId(Long id)
        +Set~ProductEntity~ getProducts()
        +void setProducts(Set~ProductEntity~ products)
        +void addProduct(ProductEntity product)
        +void removeProduct(ProductEntity product)
    }

    class OrderEntity {
        -Long id
        -double totalAmount
        -LocalDateTime orderDate
        -Set~ProductEntity~ products
        +Long getId()
        +void setId(Long id)
        +double getTotalAmount()
        +void setTotalAmount(double totalAmount)
        +LocalDateTime getOrderDate()
        +void setOrderDate(LocalDateTime orderDate)
        +Set~ProductEntity~ getProducts()
        +void setProducts(Set~ProductEntity~ products)
        +void addProduct(ProductEntity product)
        +void removeProduct(ProductEntity product)
    }

    class Serializable {
        <<interface>>
    }

    class Ticket {
        -String description
        -double price
        +String getDescription()
        +void setDescription(String description)
        +double getPrice()
        +void setPrice(double price)
        +void sellItem()
    }

    class Editable {
        <<abstract>>
        -Scanner input
        +String getInput(String)
        +int getInput(int)
        +double getInput(double)
        +boolean getInput(boolean)
        +Date getInput(Date)
        +Enum getInput(Enum)
        +edit()*
        +initialize()*
    }

    class Publication {
        <<Abstract>>
        -String title
        -double price
        -int copies
        +String getTitle()
        +void setTitle(String title)
        +double getPrice()
        +void setPrice(double price)
        +int getCopies()
        +void setCopies(int copies)
        +void sellItem()
    }

    class Book {
        -String author
        -String isbn
        +String getAuthor()
        +void setAuthor(String author)
        +String getIsbn()
        +void setIsbn(String isbn)
        +void edit()
        +void initialize()
        +void sellItem()
    }

    class Magazine {
        -int orderQty
        -LocalDateTime currentIssue
        +int getOrderQty()
        +void setOrderQty(int orderQty)
        +LocalDateTime getCurrentIssue()
        +void setCurrentIssue(LocalDateTime currentIssue)
        +void edit()
        +void initialize()
        +void sellItem()
    }

    class DiscMag {
        -boolean hasDisc
        +boolean isHasDisc()
        +void setHasDisc(boolean hasDisc)
        +void edit()
        +void initialize()
        +void sellItem()
    }

    class AbstractCosmetics {
        <<abstract>>
        -String skinType
        +String getSkinType()
        +void setSkinType(String skinType)
        +void sellItem()
    }

    class Foundation {
        -String coverageLevel
        -double price
        +String getCoverageLevel()
        +void setCoverageLevel(String coverageLevel)
        +double getPrice()
        +void setPrice(double price)
        +void sellItem()
    }

    class Lipstick {
        -String finishType
        -double price
        +String getFinishType()
        +void setFinishType(String finishType)
        +double getPrice()
        +void setPrice(double price)
        +void sellItem()
    }

    class CashTill {
        -double runningTotal
        +CashTill()
        +void showTotal()
        +void sellItem(SaleableItem item)
    }

    class SaleableItem {
        <<interface>>
        +void sellItem()
        +double getPrice()
    }