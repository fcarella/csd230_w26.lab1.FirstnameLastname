classDiagram
    Editable <|-- Product
    Product <|-- Ticket
    Product <|-- Publication
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag

    %% Niche hierarchy (Electronics)
    Product <|-- Electronics
    Electronics <|-- Laptop
    Electronics <|-- Phone

    %% Cart relationship
    Cart "0..*" -- "0..*" Product : contains

    SaleableItem <|.. Product
    Serializable <|.. Product
    Product <-- CashTill

    class Cart{
        +Long id
    }

    class Electronics{
        <<abstract>>
        -String brand
    }
    class Laptop{
        -int ramGb
    }
    class Phone{
        -boolean has5g
    }

    class Product{
        -String productId
    }

    class Serializable{
        <<interface>>
    }
    class Ticket{
        +description
        +price
        +sellItem()
    }
    class Editable{
        <<abstract>>
        -Scanner input
        +String getInput(String)
        +int getInput(int)
        +double getInput(double)
        +boolean getInput(boolean)
        +Date getInput(Date)
        +Enum getInput(Enum)
        +edit()*
        +initialize()*
    }
    class Publication{
        <<Abstract>>
        -String title
        -double price
        -int copies
        +getPrice()
    }
    class Book{
        -String author
        -String isbn
    }
    class Magazine{
        -int orderQty
        -java.time.LocalDateTime currentIssue
    }
    class DiscMag{
        -boolean hasDisc
    }
    class CashTill{
        -double runningTotal
        +showTotal()
        +sellItem(SaleableItem item)
    }
    class SaleableItem {
        <<interface>>
        +sellItem()
        +getPrice()
    }
